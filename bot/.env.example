# Supabase Credentials (Required for state, telemetry, and settings)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Binance Futures Credentials (Testnet or Mainnet)
BINANCE_API_KEY=your_binance_futures_api_key
BINANCE_API_SECRET=your_binance_futures_api_secret

# DeepSeek AI API Key (Base URL https://api.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key

# Telegram Push Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Runtime Configuration Overrides
SANDBOX_MODE=true
POLL_INTERVAL_SECONDS=15
